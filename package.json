{
  "name": "coconut",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@coconut/*' dev",
    "build": "bun run --filter '@coconut/*' build",
    "start": "bun run --parallel --filter '@coconut/*' start",
    "lint": "bun run --filter '@coconut/*' lint && bun run lint:cli",
    "typecheck": "bun run --filter '@coconut/*' typecheck && bun run typecheck:cli",
    "test": "bun run --filter '@coconut/*' test && bun run test:cli",
    "lint:cli": "bun apps/api/node_modules/eslint/bin/eslint.js --config apps/api/eslint.config.mjs scripts/composition-suite.ts scripts/composition-suite.test.ts scripts/evaluate.ts scripts/evaluate.test.ts scripts/tasks.ts scripts/tasks",
    "typecheck:cli": "bun apps/api/node_modules/typescript/bin/tsc --project tsconfig.cli.json",
    "test:cli": "bun test scripts/composition-suite.test.ts scripts/evaluate.test.ts scripts/tasks",
    "tasks:generate": "bun scripts/tasks.ts generate",
    "tasks:verify": "bun scripts/tasks.ts verify",
    "composition:generate": "bun scripts/composition-suite.ts generate",
    "composition:verify": "bun scripts/composition-suite.ts verify",
    "eval:run": "bun scripts/evaluate.ts",
    "suite:generate": "bun apps/api/src/suites/cli.ts generate",
    "suite:verify": "bun apps/api/src/suites/cli.ts verify",
    "score:report": "bun apps/api/src/scoring/cli.ts",
    "provider:check": "bun apps/api/src/providers/cli.ts",
    "model:search": "bun apps/api/src/discovery/cli.ts search",
    "model:select": "bun apps/api/src/discovery/cli.ts select",
    "challenge:generate": "bun apps/api/src/challenge/cli.ts generate",
    "challenge:verify": "bun apps/api/src/challenge/cli.ts verify",
    "interior:generate": "bun apps/api/src/interior/cli.ts generate",
    "interior:verify": "bun apps/api/src/interior/cli.ts verify",
    "reserve:generate": "bun apps/api/src/reserve/cli.ts generate",
    "reserve:verify": "bun apps/api/src/reserve/cli.ts verify",
    "numerics:setup": "uv sync --project services/numerics --python 3.13 --frozen",
    "numerics:test": "uv run --project services/numerics --frozen --no-sync python -m unittest discover -s services/numerics",
    "numerics:lint": "uv run --project services/numerics --frozen --no-sync ruff check services/numerics",
    "numerics:generate": "bun apps/api/src/numerics/cli.ts generate",
    "numerics:verify": "bun apps/api/src/numerics/cli.ts verify",
    "numerics:benchmark": "bun apps/api/src/numerics/benchmark.ts"
  },
  "patchedDependencies": {
    "openai@7.53.0": "patches/openai@7.53.0.patch"
  }
}
